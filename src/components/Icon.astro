---
import type { IconName } from '@/data/services';

interface Props {
  name: IconName | 'arrow' | 'check' | 'pin' | 'whatsapp' | 'menu' | 'close' | 'plus';
  class?: string;
}
const { name, class: className = 'size-6' } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'windshield' && (
    <>
      <path d="M7 8h18l4 13c-8-2-18-2-26 0L7 8Z" />
      <path d="M10 17c2-4 5-6 9-6.5" />
      <path d="M24.5 3.5v3M23 5h3M27.5 9v2M26.5 10h2" stroke-width="1.6" />
    </>
  )}
  {name === 'car' && (
    <>
      <path d="M5 19l2.4-6.4A3 3 0 0 1 10.2 10.6h11.6a3 3 0 0 1 2.8 2L27 19" />
      <path d="M4 19h24v5a1 1 0 0 1-1 1h-2.5a1 1 0 0 1-1-1v-1.5h-15V24a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-5Z" />
      <path d="M8.5 19l1.6-4.5h11.8L23.5 19" />
      <circle cx="8.5" cy="21.5" r=".8" fill="currentColor" />
      <circle cx="23.5" cy="21.5" r=".8" fill="currentColor" />
    </>
  )}
  {name === 'adas' && (
    <>
      <path d="M9.5 20l1.6-4.3A2 2 0 0 1 13 14.4h6a2 2 0 0 1 1.9 1.3l1.6 4.3" />
      <path d="M8.5 20h15v3.5a.8.8 0 0 1-.8.8h-1.8a.8.8 0 0 1-.8-.8v-1H11.9v1a.8.8 0 0 1-.8.8H9.3a.8.8 0 0 1-.8-.8V20Z" />
      <path d="M5.5 14.5a9 9 0 0 0 0 9M2.5 12a13 13 0 0 0 0 14" />
      <path d="M26.5 14.5a9 9 0 0 1 0 9M29.5 12a13 13 0 0 1 0 14" />
    </>
  )}
  {name === 'impact' && (
    <>
      <path d="M16 3l1.8 9.2L26 7l-5.2 8.2L30 16l-9.2 1.8L26 26l-8.2-5.2L16 30l-1.8-9.2L6 26l5.2-8.2L2 16l9.2-1.8L6 6l8.2 5.2L16 3Z" />
      <circle cx="16" cy="16" r="2" />
    </>
  )}
  {name === 'tint' && (
    <>
      <path d="M4 24 9 9h17l2 15H4Z" />
      <path d="M9 9 4 24h12L23 9" fill="currentColor" fill-opacity=".22" stroke="none" />
      <path d="M13 21l6-9" />
    </>
  )}
  {name === 'van' && (
    <>
      <path d="M3 22V10a2 2 0 0 1 2-2h14l5 5 4 2.5a2 2 0 0 1 1 1.7V22H3Z" />
      <path d="M19 8v6h9" />
      <circle cx="9" cy="23" r="2.5" fill="white" />
      <circle cx="23" cy="23" r="2.5" fill="white" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M16 3 5 7v8c0 7 4.6 11.6 11 14 6.4-2.4 11-7 11-14V7L16 3Z" />
      <path d="m11 16 3.5 3.5L21.5 12" />
    </>
  )}
  {name === 'gift' && (
    <>
      <rect x="4" y="11" width="24" height="6" rx="1" />
      <path d="M6 17v10h20V17M16 11v16" />
      <path d="M16 11c-2-5-8-6-8-2.5S13 11 16 11ZM16 11c2-5 8-6 8-2.5S19 11 16 11Z" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="16" cy="16" r="12" />
      <path d="M16 9v7l4.5 3" />
    </>
  )}
  {name === 'phone' && (
    <path d="M11.5 4.5 8 4a3 3 0 0 0-3.4 3C5 17.6 14.4 27 25 27.4A3 3 0 0 0 28 24l-.5-3.5a1.5 1.5 0 0 0-1.1-1.2l-4.2-1.1a1.5 1.5 0 0 0-1.5.4l-1.8 1.9a15 15 0 0 1-7.4-7.4l1.9-1.8a1.5 1.5 0 0 0 .4-1.5l-1.1-4.2a1.5 1.5 0 0 0-1.2-1.1Z" />
  )}
  {name === 'arrow' && <path d="M6 16h20M19 9l7 7-7 7" />}
  {name === 'check' && <path d="m7 16.5 6 6L25 10" />}
  {name === 'plus' && <path d="M16 7v18M7 16h18" />}
  {name === 'pin' && (
    <>
      <path d="M16 29s9-8.3 9-15.5a9 9 0 0 0-18 0C7 20.7 16 29 16 29Z" />
      <circle cx="16" cy="13.5" r="3.2" />
    </>
  )}
  {name === 'menu' && <path d="M5 10h22M5 16h22M5 22h14" />}
  {name === 'close' && <path d="M8 8l16 16M24 8 8 24" />}
  {name === 'whatsapp' && (
    <>
      <path d="M5 27l1.7-5.3A11.5 11.5 0 1 1 11 26L5 27Z" />
      <path
        d="M12 10.5c-.6 0-1.6.8-1.6 2.3 0 3 3.8 7.6 8 8.6 1.4.3 2.6-.6 2.8-1.4l.2-1-2.6-1.3-1.1 1.2c-1.6-.5-3.3-2.2-3.9-3.9l1.2-1.1-1.2-2.7-.9-.1Z"
        fill="currentColor"
        stroke="none"
      />
    </>
  )}
</svg>

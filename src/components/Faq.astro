---
import type { Faq } from '@/data/services';
import Icon from './Icon.astro';

interface Props {
  items: Faq[];
  tone?: 'light' | 'paper';
}
const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {items.map((f) => (
    <details class="group" name="faq">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[17px] font-bold text-navy hover:text-blue">
        {f.q}
        <Icon
          name="plus"
          class="mt-0.5 size-5 shrink-0 text-blue transition-transform duration-200 group-open:rotate-45"
        />
      </summary>
      <p class="-mt-1 max-w-3xl pb-6 text-mute">{f.a}</p>
    </details>
  ))}
</div>

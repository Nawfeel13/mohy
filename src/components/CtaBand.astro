---
import Icon from './Icon.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
}
const { title = 'Un impact, une fissure, une vitre cassée ?' } = Astro.props;
---

<section class="bg-blue text-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2 class="display text-3xl sm:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-white/85">{site.hours.label}. Réponse immédiate par téléphone.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={site.phone.href}
        class="btn bg-white text-lg text-ink hover:bg-sky"
        data-track="call-cta"
      >
        <Icon name="phone" class="size-5 text-blue" />
        {site.phone.display}
      </a>
      <a
        href={`https://wa.me/${site.phone.whatsapp}`}
        class="btn text-lg ring-2 ring-white/60 ring-inset hover:bg-white/10"
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" class="size-5" />
        Envoyer une photo
      </a>
    </div>
  </div>
</section>

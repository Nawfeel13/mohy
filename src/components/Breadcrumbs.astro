---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="text-[13px] text-white/50">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li>
      <a href="/" class="hover:text-white">
        Accueil
      </a>
    </li>
    {items.map((it) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true">/</span>
        {it.href ? (
          <a href={it.href} class="hover:text-white">
            {it.label}
          </a>
        ) : (
          <span aria-current="page" class="text-white/80">
            {it.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

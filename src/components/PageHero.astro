---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
---

<section class="relative overflow-hidden bg-ink text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_24rem_at_85%_-10%,rgb(35_135_240/0.28),transparent_70%)]"></div>
  <div class="relative mx-auto max-w-7xl px-4 pt-8 pb-14 sm:px-6 lg:pb-20">
    <Breadcrumbs items={crumbs} />
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="max-w-3xl min-w-0">
        {eyebrow && <p class="eyebrow !text-neon">{eyebrow}</p>}
        <h1 class="display mt-4 text-[2rem] leading-[1.02] min-[400px]:text-[2.4rem] sm:text-6xl">
          {title}
        </h1>
        {lead && <p class="mt-6 max-w-2xl text-lg text-white/75">{lead}</p>}
      </div>
      <slot />
    </div>
  </div>
  <div class="neon-rule relative mx-4 sm:mx-6"></div>
</section>

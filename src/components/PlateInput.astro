---
/** Champ d'immatriculation au format plaque française (bande bleue UE + F). */
interface Props {
  id: string;
  name?: string;
  value?: string;
  size?: 'md' | 'lg';
  required?: boolean;
}
const { id, name = 'immatriculation', value = '', size = 'md', required = false } = Astro.props;
---

<div
  class:list={[
    'flex overflow-hidden rounded-md bg-white ring-2 ring-ink/85 focus-within:ring-blue',
    size === 'lg' ? 'h-16' : 'h-14',
  ]}
>
  <span
    class="flex w-9 shrink-0 flex-col items-center justify-end bg-plate pb-1.5 text-white"
    aria-hidden="true"
  >
    <svg viewBox="0 0 20 20" class="mb-auto mt-1.5 size-4">
      {Array.from({ length: 12 }, (_, i) => {
        const a = (i * Math.PI) / 6;
        return (
          <circle cx={10 + 7 * Math.cos(a)} cy={10 + 7 * Math.sin(a)} r="1.15" fill="#ffcc00" />
        );
      })}
    </svg>
    <span class="text-sm font-bold">F</span>
  </span>
  <input
    id={id}
    name={name}
    value={value}
    required={required}
    inputmode="text"
    autocomplete="off"
    autocapitalize="characters"
    spellcheck="false"
    maxlength="10"
    placeholder="AB-123-CD"
    pattern="[A-Za-z]{2}[\s\-]?[0-9]{3}[\s\-]?[A-Za-z]{2}|[0-9]{1,4}[\s\-]?[A-Za-z]{1,3}[\s\-]?[0-9]{2,3}"
    title="Format AB-123-CD (ou ancien format 123 ABC 45)"
    class:list={[
      'w-full min-w-0 bg-transparent px-3 text-center font-black tracking-[0.12em] text-ink uppercase placeholder:text-ink/25 focus:outline-none',
      size === 'lg' ? 'text-[1.7rem]' : 'text-[1.4rem]',
    ]}
    style="font-variation-settings:'wdth' 92"
    data-plate
  />
</div>

---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import Steps from '@/components/Steps.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, type Service } from '@/data/services';
import { site, inCity } from '@/config/site';

export const getStaticPaths = (() =>
  services.map((s) => ({ params: { service: s.slug }, props: { s } }))) satisfies GetStaticPaths;

interface Props {
  s: Service;
}
const { s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
const url = (p: string) => new URL(p, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.label,
    serviceType: s.label,
    description: s.metaDescription,
    url: url(`/${s.slug}`),
    provider: { '@id': url('/#entreprise') },
    ...(site.address.city ? { areaServed: { '@type': 'City', name: site.address.city } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: url('/') },
      { '@type': 'ListItem', position: 2, name: s.label, item: url(`/${s.slug}`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={s.metaTitle} description={s.metaDescription} schema={schema}>
  <PageHero
    eyebrow={`Prestation${inCity}`}
    title={s.h1}
    lead={s.lead}
    crumbs={[{ label: s.label }]}
  >
    <dl class="grid min-w-[17rem] gap-px overflow-hidden rounded-lg bg-white/10 ring-1 ring-white/10">
      {s.facts.map((f) => (
        <div class="bg-ink-2/90 px-5 py-4">
          <dt class="text-[13px] text-white/50">{f.k}</dt>
          <dd class="mt-0.5 text-lg font-bold">{f.v}</dd>
        </div>
      ))}
    </dl>
  </PageHero>

  <div class="mx-auto grid max-w-7xl gap-14 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_20rem] lg:gap-20 lg:py-20">
    <article class="min-w-0 space-y-14">
      {s.blocks.map((b) => (
        <section>
          <h2 class="display text-2xl text-navy sm:text-3xl">{b.title}</h2>
          {b.body && (
            <div class="prose-pg mt-5 max-w-3xl text-[17px] text-ink/80">
              {b.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          )}
          {b.list && (
            <ul class="mt-5 max-w-3xl space-y-3">
              {b.list.map((li) => (
                <li class="flex gap-3 text-ink/80">
                  <Icon name="check" class="mt-1 size-5 shrink-0 text-blue" />
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <section>
        <h2 class="display text-2xl text-navy sm:text-3xl">Questions fréquentes</h2>
        <div class="mt-6">
          <Faq items={s.faq} />
        </div>
      </section>
    </article>

    <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-xl bg-paper p-6">
        <Icon name={s.icon} class="size-10 text-navy" />
        <p class="mt-4 text-lg font-bold text-navy">Un devis pour votre véhicule</p>
        <p class="mt-1.5 text-[15px] text-mute">Gratuit et sans engagement.</p>
        <a href={`/devis?prestation=${s.slug}`} class="btn btn-primary mt-5 w-full">
          Demander un devis
        </a>
        <a href={site.phone.href} class="btn btn-ghost mt-2.5 w-full" data-track="call-aside">
          <Icon name="phone" class="size-[18px]" />
          {site.phone.display}
        </a>
      </div>
      <div class="rounded-xl p-6 ring-1 ring-line">
        <p
          class="flex items-center gap-2.5 font-extrabold text-gift uppercase"
          style="font-variation-settings:'wdth' 110"
        >
          <Icon name="gift" class="size-6" />
          {site.offer.headline}
        </p>
        <p class="mt-2 text-sm text-mute">
          Avec la garantie bris de glace.{' '}
          <a
            href="/assurance-franchise-offerte"
            class="font-semibold text-blue underline underline-offset-2"
          >
            Conditions
          </a>
        </p>
      </div>
      <nav aria-label="Autres prestations">
        <p class="text-sm font-bold tracking-widest text-mute uppercase">Autres prestations</p>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {others.map((o) => (
            <li>
              <a
                href={`/${o.slug}`}
                class="flex items-center gap-3 py-3 font-semibold text-navy hover:text-blue"
              >
                <Icon name={o.icon} class="size-6" />
                {o.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>

  <section class="bg-navy">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="display text-3xl text-white">Comment ça se passe</h2>
      <div class="mt-8">
        <Steps />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

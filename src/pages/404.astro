---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
---

<Base title="Page introuvable" description="Cette page n'existe pas." noindex>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-3xl px-4 py-28 text-center sm:px-6">
      <Icon name="impact" class="mx-auto size-16 text-neon" />
      <h1 class="display mt-8 text-5xl">Page introuvable</h1>
      <p class="mt-5 text-lg text-white/70">
        Le lien est cassé, mais votre pare-brise, on peut le réparer.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">
          Retour à l’accueil
        </a>
        <a href={site.phone.href} class="btn btn-ghost-dark">
          <Icon name="phone" class="size-5" />
          {site.phone.display}
        </a>
      </div>
    </div>
  </section>
</Base>

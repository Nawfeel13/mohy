# URL publique du site (canonical, sitemap, Open Graph)
SITE_URL=https://www.pareglass-auto.fr

# Point d'envoi du formulaire de devis (Formspree, Web3Forms, Getform…).
# Laisser vide : le formulaire bascule automatiquement sur un envoi WhatsApp pré-rempli.
PUBLIC_FORM_ENDPOINT=

# --- Identification du véhicule par la plaque (/api/vehicule) ---
# Fournisseur : apiplaque (réel), mock (démo : véhicules FICTIFS, pour tester l'affichage), off.
# Par défaut : apiplaque si un jeton est présent, sinon désactivé (le client saisit marque et modèle).
PLATE_API_PROVIDER=
# Jeton fourni par apiplaqueimmatriculation.com (secret : jamais exposé au navigateur).
PLATE_API_TOKEN=
# Facultatif : URL de l'API si elle diffère de la valeur par défaut.
PLATE_API_URL=
# 1 = affiche la réponse brute de l'API dans la console du serveur (pour vérifier le mapping).
PLATE_API_DEBUG=
